{% comment %}
  Rendered on demand by the fit quiz through the Section Rendering API:
  GET /collections/shape-a?section_id=shape-products
  Returns a small product grid for the collection in the request context.
  Not meant to be placed in a template.
{% endcomment %}

{%- if collection != blank -%}
  <div data-shape-products-inner>
    <ul class="grid product-grid grid--2-col-tablet-down grid--4-col-desktop" role="list">
      {%- for product in collection.products limit: section.settings.products_to_show -%}
        <li class="grid__item">
          {% render 'card-product',
            card_product: product,
            media_aspect_ratio: 'portrait',
            show_secondary_image: true,
            section_id: section.id
          %}
        </li>
      {%- else -%}
        <li class="grid__item"><p>{{ 'saahvay.labels.no_products_yet' | t }}</p></li>
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Shape products (quiz)",
  "settings": [
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4,
      "label": "Products to show"
    }
  ]
}
{% endschema %}
