{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "eyebrow": {
          "type": "text",
          "settings": {
            "text": "Complete look",
            "text_style": "uppercase"
          }
        },
        "title": { "type": "title" },
        "fit_module": {
          "type": "fit_module",
          "settings": {
            "heading": "Selected for",
            "size_guide_page": "fit-and-sizing",
            "quiz_page": "fit-quiz"
          }
        },
        "description": { "type": "description" }
      },
      "block_order": ["eyebrow", "title", "fit_module", "description"],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "stacked",
        "media_size": "medium",
        "constrain_to_viewport": true,
        "media_fit": "cover",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 24,
        "padding_bottom": 0
      }
    },
    "builder": {
      "type": "outfit-builder",
      "settings": {
        "heading": "Build this look",
        "text": "Choose your size for each piece. Untick anything you already own.",
        "color_scheme": "scheme-1",
        "padding_top": 24,
        "padding_bottom": 72
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "More complete looks",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-2",
        "image_ratio": "portrait",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 48,
        "padding_bottom": 72
      }
    }
  },
  "order": ["main", "builder", "related-products"]
}
